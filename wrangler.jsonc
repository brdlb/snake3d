{
    "name": "snake3d",
    "main": "worker/index.ts",
    "compatibility_date": "2025-12-12",
    "assets": {
        "directory": "./dist"
    },
    "routes": [{ "pattern": "snake.brdlb.com", "custom_domain": true }],
    "d1_databases": [{ "binding": "DB", "database_name": "snake3d", "database_id": "791bff91-65ad-409a-afb9-4ea22896eccf" }],
    "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }]
}
